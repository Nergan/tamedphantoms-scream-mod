{
  "schemaVersion": 1,
  "id": "tamedphantomsscream",
  "version": "${version}",
  "name": "Tamed Phantoms: Scream",
  "description": "Phantoms cry in self-defense, in play, under a full moon, and from the spare scream key. An addon for Tamed Phantoms.",
  "authors": ["Tamed Phantoms contributors"],
  "contact": {
    "homepage": "https://github.com/Nergan/tamedphantoms-scream-mod",
    "issues": "https://github.com/Nergan/tamedphantoms-scream-mod/issues"
  },
  "license": "MPL-2.0",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.tamedphantomsscream.mod.loader.fabric.TamedPhantomsScreamFabric"],
    "client": ["com.tamedphantomsscream.mod.loader.fabric.TamedPhantomsScreamFabricClient"]
  },
  "mixins": [
    "tamedphantomsscream.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.2+kotlin.2.1.20",
    "tamedphantoms": ">=${tamedphantoms_version}"
  },
  "suggests": {
    "patchouli": "*"
  }
}
